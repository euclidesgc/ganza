#!/usr/bin/env bash
#
# Barra credencial antes de ela entrar no histórico.
#
# Por que no pre-COMMIT e não no pre-push: o GitGuardian escaneia **todos os
# commits do PR**, não o estado final. Corrigir num commit seguinte não limpa
# nada — o PR continua vermelho e a única saída é reescrever o branch. Isso já
# custou um squash no PR #3 e outro no #5. O lugar certo de barrar é antes de
# o commit existir.
#
# Instalação (uma vez por clone, junto com o pre-push):
#   git config core.hooksPath scripts/git-hooks
#
# Escape consciente, quando o achado for comprovadamente falso positivo:
#   GANZA_ALLOW_SECRET=1 git commit ...

set -uo pipefail

[ "${GANZA_ALLOW_SECRET:-0}" = "1" ] && exit 0

arquivos=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$arquivos" ] && exit 0

achados=0

reportar() { # <arquivo> <linha> <motivo> <trecho>
  printf '\n  ✗ %s:%s — %s\n      %s\n' "$1" "$2" "$3" "$4"
  achados=1
}

# Valor que se lê como exemplo não é segredo. Sem esta lista, todo `.example`
# e todo teste honesto viraria falso positivo, e hook que grita à toa é hook
# que o dev desliga.
placeholder='(\.invalid|exemplo|example|placeholder|cole-aqui|redacted|xxxx|<[^>]+>|\$\{|dummy|fake|changeme|your-|seu-|nao-e-uma)'

# Os prefixos são montados por concatenação de propósito. Escritos inteiros,
# ESTE arquivo vira o achado: `AKI`+`A…`, `gh`+`p_…` e `AIz`+`a…` são as
# assinaturas que o GitGuardian procura, e ele não sabe que aqui elas são a
# rede, não o peixe. Foi o que deixou o PR #5 vermelho com "3 secrets".
MARCA_JWT='ey''J[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}'
MARCA_ENTRADA="(pass""word|se""nha|pass""wd|p""wd)[a-zA-Z_]*[\"']?[[:space:]]*[:=][[:space:]]*[\"'][^\"']{6,}[\"']"
MARCA_ATRIBUICAO="(api[_-]?k""ey|sec""ret|access[_-]?to""ken|service[_-]?r""ole)[a-zA-Z_]*[\"']?[[:space:]]*[:=][[:space:]]*[\"'][A-Za-z0-9/+_-]{16,}[\"']"
MARCA_PROVEDOR='(AKI''A[0-9A-Z]{16}|gh''[pousr]_[A-Za-z0-9]{20,}|sk''-[A-Za-z0-9]{20,}|AIz''a[0-9A-Za-z_-]{30,}|-----BEG''IN [A-Z ]*PRIVATE KEY-----)'

for arquivo in $arquivos; do
  [ -f "$arquivo" ] || continue
  case "$arquivo" in
    scripts/git-hooks/*) continue ;;
    *.png|*.jpg|*.jpeg|*.gif|*.webp|*.ico|*.ttf|*.otf|*.woff*|*.apk|*.aab|*.jar|*.zip) continue ;;
  esac

  while IFS=: read -r linha conteudo; do
    [ -z "${linha:-}" ] && continue
    printf '%s' "$conteudo" | grep -qiE "$placeholder" && continue
    reportar "$arquivo" "$linha" "parece um JSON Web Token" "$(printf '%.90s' "$conteudo")"
  done < <(grep -nE "$MARCA_JWT" "$arquivo" 2>/dev/null)

  while IFS=: read -r linha conteudo; do
    [ -z "${linha:-}" ] && continue
    printf '%s' "$conteudo" | grep -qiE "$placeholder" && continue
    reportar "$arquivo" "$linha" "parece uma chave de provedor" "$(printf '%.90s' "$conteudo")"
  done < <(grep -nE "$MARCA_PROVEDOR" "$arquivo" 2>/dev/null)

  # O par e-mail + senha literal é o que o GitGuardian marca como credencial
  # genérica — foi o achado dos PRs #3 e #5. Em teste, use um domínio
  # `.invalid` e uma senha que se leia como placeholder.
  while IFS=: read -r linha conteudo; do
    [ -z "${linha:-}" ] && continue
    printf '%s' "$conteudo" | grep -qiE "$placeholder" && continue
    reportar "$arquivo" "$linha" "senha literal (use .invalid e um placeholder legível)" "$(printf '%.90s' "$conteudo")"
  done < <(grep -nE "$MARCA_ENTRADA" "$arquivo" 2>/dev/null)

  while IFS=: read -r linha conteudo; do
    [ -z "${linha:-}" ] && continue
    printf '%s' "$conteudo" | grep -qiE "$placeholder" && continue
    reportar "$arquivo" "$linha" "segredo atribuído em literal" "$(printf '%.90s' "$conteudo")"
  done < <(grep -nE "$MARCA_ATRIBUICAO" "$arquivo" 2>/dev/null)
done

# Workflow com job duplicado passa em qualquer parser YAML e é recusado pelo
# GitHub sem gerar log. Barrar aqui é mais barato que descobrir em develop.
if printf '%s\n' $arquivos | grep -q '^\.github/workflows/'; then
  if ! bash "$(dirname "${BASH_SOURCE[0]}")/../validar-workflows.sh"; then
    achados=1
  fi
fi

if [ "$achados" -ne 0 ]; then
  cat <<'FIM'

✗ pre-commit: possível credencial acima.

  O GitGuardian escaneia TODOS os commits de um PR, não o estado final —
  corrigir depois não limpa, só reescrevendo o branch. Resolva agora:

    • em teste, use domínio `.invalid` e senha que se leia como placeholder;
    • segredo de verdade vai para env/Vault, nunca para o repositório;
    • falso positivo comprovado? GANZA_ALLOW_SECRET=1 git commit ...

FIM
  exit 1
fi

exit 0
